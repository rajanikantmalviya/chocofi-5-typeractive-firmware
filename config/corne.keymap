#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>


#define AS(keycode) &as LS(keycode) keycode

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hrm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mods";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Fixed-parameter macros expose movement and scrolling in Studio on ZMK v0.3.
        ZMK_MACRO(mouse_move_left,
            display-name = "Mouse Move Left";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_LEFT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_LEFT>;
        )
        ZMK_MACRO(mouse_move_right,
            display-name = "Mouse Move Right";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_RIGHT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_RIGHT>;
        )
        ZMK_MACRO(mouse_move_up,
            display-name = "Mouse Move Up";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_UP>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_UP>;
        )
        ZMK_MACRO(mouse_move_down,
            display-name = "Mouse Move Down";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_DOWN>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_DOWN>;
        )
        ZMK_MACRO(mouse_scroll_left,
            display-name = "Mouse Scroll Left";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_LEFT>, <&macro_pause_for_release>, <&macro_release &msc SCRL_LEFT>;
        )
        ZMK_MACRO(mouse_scroll_right,
            display-name = "Mouse Scroll Right";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_RIGHT>, <&macro_pause_for_release>, <&macro_release &msc SCRL_RIGHT>;
        )
        ZMK_MACRO(mouse_scroll_up,
            display-name = "Mouse Scroll Up";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_UP>, <&macro_pause_for_release>, <&macro_release &msc SCRL_UP>;
        )
        ZMK_MACRO(mouse_scroll_down,
            display-name = "Mouse Scroll Down";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_DOWN>, <&macro_pause_for_release>, <&macro_release &msc SCRL_DOWN>;
        )
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  |
//             | ESC | TAB | SPC |     | ENT | DEL | BSPC |
// Tab/Delete hold Number (layer 2); Space/Enter hold Nav (layer 1).
                        display-name = "Base";
                        bindings = <
   &kp Q         &kp W        &kp E        &kp R        &kp T     &kp Y     &kp U        &kp I        &kp O         &kp P
   &hrm LSHIFT A &hrm LCTRL S &hrm LGUI D  &hrm LALT F  &kp G     &kp H     &hrm RALT J &hrm RGUI K &hrm RCTRL L  &hrm RSHIFT SEMI
   &kp Z         &kp X        &kp C        &kp V        &kp B     &kp N     &kp M        &kp COMMA    &kp DOT       &kp FSLH
                             &kp ESC      &lt 2 TAB    &lt 1 SPACE     &lt 1 RET &lt 2 DEL &kp BSPC
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// | !     |  @  |  #  |  $  |  %  |     |  ^  |  &  |  *  |  (  |  )  |
// | BT1   | MLEFT | BT3 | MRIGHT | BT5 |   | LFT | DWN | UP | RGT |   |
// | BTCLR |     |     |     |     |     |     |     |     |     |     |
//               | GUI |     | SPC |     | ENT | ESC | TAB |
                        display-name = "Nav";
                        bindings = <
   &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT        &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR  &kp RPAR
   &bt BT_SEL 0 &mouse_move_left &bt BT_SEL 2 &mouse_move_right &bt BT_SEL 4     &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
   &bt BT_CLR   &trans       &trans       &trans       &trans           &trans    &trans    &trans          &trans    &trans 
                             &kp LGUI     &trans       &kp SPACE        AS(RET)   &kp ESC   &kp TAB
                        >;
                };

                number_layer {
// -----------------------------------------------------------------------------------------
// | 1! |  2@ |  3# |  4$ |  5% |     |  6^ |  7& |  8* |  9(  |  0)  |
// | -~ |  =+ |     |     |     |     |     |  [  |  ]  |  \|  |  '   |
// |    |     |     |     |     |     |     |     |     |      |      |
//            |     |     |     |     |     |     |     |
                        display-name = "Number";
                        bindings = <

   AS(N1)    AS(N2)    AS(N3)    AS(N4)    AS(N5)        AS(N6)    AS(N7)    AS(N8)    AS(N9)   AS(N0)
   &as TILDE MINUS AS(EQUAL) &none &none &none          &none &as LBKT LBKT &as RBKT RBKT AS(BSLH) &as SQT SQT
   &none     &none     &none     &none     &none        &none     &none     &none     &none    &none
                       &none     &none     &none        &none     &none     &none
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
