                        &mkp 1
                        &mkp 2
                        &mkp 4
                    >;
                };
                shifted_number_layer {
                    display-name = "Number + Shift";
                    bindings = <
                        &kp 34013214
                        &kp 34013215
                        &kp 34013216
                        &kp 34013217
                        &kp 34013218
                        &kp 34013219
                        &kp 34013220
