                    >;
                };
                number_layer {
                    display-name = "Number";
                    bindings = <
                        &kp 458782
                        &kp 458783
                        &kp 458784
                        &kp 458785
                        &kp 458786
                        &kp 458787
                        &kp 458788
                        &kp 458789
                        &kp 458790
                        &kp 458791
                        &kp 458805
                        &kp 458797
                        &kp 458798
                        &none
