#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV 1
#define NUMBER 2
#define FUNC 3
#define NUMBER_SHIFT 4

#define AS(keycode) &as LS(keycode) keycode

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hrm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mods";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hrm_left: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mods Left";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hrm_right: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mods Right";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        td_func: function_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Function One Shot";
            tapping-term-ms = <200>;
            bindings = <&sl FUNC>;
        };

        // Fixed-parameter macros expose movement and scrolling in Studio on ZMK v0.3.
        ZMK_MACRO(mouse_move_left,
            display-name = "Mouse Move Left";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_LEFT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_LEFT>;
        )
        ZMK_MACRO(mouse_move_right,
            display-name = "Mouse Move Right";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_RIGHT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_RIGHT>;
        )
        ZMK_MACRO(mouse_move_up,
            display-name = "Mouse Move Up";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_UP>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_UP>;
        )
        ZMK_MACRO(mouse_move_down,
            display-name = "Mouse Move Down";
            wait-ms = <0>;
            bindings = <&macro_press &mmv MOVE_DOWN>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_DOWN>;
        )
        ZMK_MACRO(mouse_scroll_left,
            display-name = "Mouse Scroll Left";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_LEFT>, <&macro_pause_for_release>, <&macro_release &msc SCRL_LEFT>;
        )
        ZMK_MACRO(mouse_scroll_right,
            display-name = "Mouse Scroll Right";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_RIGHT>, <&macro_pause_for_release>, <&macro_release &msc SCRL_RIGHT>;
        )
        ZMK_MACRO(mouse_scroll_up,
            display-name = "Mouse Scroll Up";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_UP>, <&macro_pause_for_release>, <&macro_release &msc SCRL_UP>;
        )
        ZMK_MACRO(mouse_scroll_down,
            display-name = "Mouse Scroll Down";
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_DOWN>, <&macro_pause_for_release>, <&macro_release &msc SCRL_DOWN>;
        )
    };

    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <80>;
            key-positions = <6 7>;
            layers = <BASE>;
            bindings = <&kp BSPC>;
        };

        combo_delete {
            timeout-ms = <80>;
            key-positions = <7 8>;
            layers = <BASE>;
            bindings = <&kp DEL>;
        };

        combo_enter_right {
            timeout-ms = <80>;
            key-positions = <16 17 18>;
            layers = <BASE>;
            bindings = <&kp RET>;
        };

        combo_space_right {
            timeout-ms = <80>;
            key-positions = <16 17>;
            layers = <BASE>;
            bindings = <&kp SPACE>;
        };

        combo_space_left {
            timeout-ms = <80>;
            key-positions = <12 13>;
            layers = <BASE>;
            bindings = <&kp SPACE>;
        };

        combo_enter_left {
            timeout-ms = <80>;
            key-positions = <11 12 13>;
            layers = <BASE>;
            bindings = <&kp RET>;
        };

        combo_escape {
            timeout-ms = <80>;
            key-positions = <0 1>;
            layers = <BASE>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <80>;
            key-positions = <1 2>;
            layers = <BASE>;
            bindings = <&kp TAB>;
        };

        combo_number_er {
            timeout-ms = <80>;
            key-positions = <2 3>;
            layers = <BASE NUMBER>;
            bindings = <&tog NUMBER>;
        };

        combo_function {
            timeout-ms = <80>;
            key-positions = <1 2 3>;
            layers = <BASE>;
            bindings = <&td_func>;
        };

        combo_shift {
            timeout-ms = <80>;
            key-positions = <10 11>;
            layers = <BASE NAV NUMBER FUNC NUMBER_SHIFT>;
            bindings = <&kt LSHIFT>;
        };
    };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  |
//             | ESC | TAB | SPC |     | ENT | DEL | BSPC |
// Esc holds Func; Tab/Delete hold Number; Space/Enter hold Nav.
                        display-name = "Base";
                        bindings = <
   &kp Q         &kp W        &kp E        &kp R        &kp T     &kp Y     &kp U        &kp I        &kp O         &kp P
   &hrm_left LSHIFT A &hrm_left LCTRL S &hrm_left LGUI D &hrm_left LALT F &kp G &kp H &hrm_right RALT J &hrm_right RGUI K &hrm_right RCTRL L &hrm_right RSHIFT SEMI
   &kp Z         &kp X        &kp C        &kp V        &kp B     &kp N     &kp M        &kp COMMA    &kp DOT       &kp FSLH
                             &lt FUNC ESC &lt NUMBER TAB &lt NAV SPACE     &lt NAV RET &lt NUMBER DEL &kp BSPC
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// |       |       | MUP  | SCRUP  |      |   | PGUP | HOME | UP   | END   | |
// | RCLK  | MLEFT | MDWN | MRIGHT | LCLK |   | PGDN | LEFT | DOWN | RIGHT | |
// | BTCLR |       |      | SCRDWN |      |   | LCLK |      |      |       | |
// All thumb keys are disabled on Nav, matching the JSON seed.
                        display-name = "Nav";
                        bindings = <
   &none       &none            &mouse_move_up   &mouse_scroll_up  &none        &kp PG_UP &kp HOME &kp UP   &kp END   &none
   &mkp RCLK   &mouse_move_left &mouse_move_down &mouse_move_right &mkp LCLK    &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &none
   &bt BT_CLR  &trans           &trans           &mouse_scroll_down &trans     &mkp LCLK &none    &none    &none     &none
                                &none           &none              &none      &none     &none    &none
                        >;
                };

                number_layer {
// -----------------------------------------------------------------------------------------
// | 1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9   |  0   |
// | `  |  =  |     |     |     |     |     |  [  |  ]  |  \   |  '   |
// |    |     |     |     |     |     |     |     |     |      |      |
//            |     |     |     |     |     |     |     |
                        display-name = "Number";
                        bindings = <

   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5        &kp N6    &kp N7    &kp N8    &kp N9   &kp N0
   &kp GRAVE &kp EQUAL &none     &none     &none         &none     &kp LBKT  &kp RBKT  &kp BSLH &kp SQT
   &none     &none     &none     &none     &none        &none     &none     &none     &none    &none
                       &none     &none     &none        &none     &none     &none
                        >;
                };

                function_layer {
                        display-name = "Func";
                        bindings = <
   &kp F1       &kp F2       &kp F3      &kp F4      &kp F5       &kp F6 &kp F7   &kp F8     &kp F9     &kp F10
   &kp C_BRI_DN &kp C_BRI_UP &none       &none       &kp C_AL_CALC &none  &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp F11
   &bt BT_PRV   &bt BT_NXT   &out OUT_USB &out OUT_BLE &none        &none  &none     &none        &none       &kp F12
                            &none       &none        &none        &none  &none     &none
                        >;
                };

                shifted_number_layer {
                        display-name = "Number + Shift";
                        bindings = <
   &kp LS(N1)    &kp LS(N2)    &kp LS(N3) &kp LS(N4) &kp LS(N5)     &kp LS(N6) &kp LS(N7)   &kp LS(N8)   &kp LS(N9)   &kp LS(N0)
   &kp LS(GRAVE) &kp LS(EQUAL) &none      &none      &none          &none      &kp LS(LBKT) &kp LS(RBKT) &kp LS(BSLH) &kp LS(SQT)
   &none         &none         &none      &none      &none          &none      &none        &none        &none        &none
                              &none      &none      &none          &none      &none        &none
                        >;
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
